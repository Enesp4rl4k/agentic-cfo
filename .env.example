# AI CFO — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# ── LLM API Key ───────────────────────────────────────────────────────────────
# Works with DeepSeek (recommended) or OpenAI
OPENAI_API_KEY=sk-...

# ── LLM Settings ──────────────────────────────────────────────────────────────
# DeepSeek (cost-effective, recommended):
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
# OpenAI GPT-4o (comment out above, uncomment below):
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=16384

# ── Database ──────────────────────────────────────────────────────────────────
# Dev mode: SQLite (no setup required)
USE_SQLITE=true

# Production: PostgreSQL (set USE_SQLITE=false and fill in below)
# USE_SQLITE=false
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=aicfo
# POSTGRES_USER=aicfo
# POSTGRES_PASSWORD=changeme

# Or override entirely with a full URL:
# DATABASE_URL_OVERRIDE=postgresql+asyncpg://user:pass@host:5432/dbname

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_SECRET_KEY=change-this-to-a-random-secret-32-chars
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── NextAuth (required for auth to work) ──────────────────────────────────────
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=change-this-to-a-random-32-char-secret
NEXTAUTH_URL=http://localhost:3000

# ── Pilot Program ─────────────────────────────────────────────────────────────
PILOT_MODE=true
PILOT_MAX_USERS=5
# Set to false to disable invite-code requirement (open registration)
PILOT_REQUIRE_INVITE=true

# ── File Storage ──────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_SIZE_MB=10

# S3 (optional, set STORAGE_BACKEND=s3 to use):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=us-east-1

# ── Redis (optional — not required for SQLite dev mode) ───────────────────────
REDIS_URL=redis://localhost:6379/0
