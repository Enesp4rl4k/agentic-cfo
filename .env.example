# AI CFO — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# ── LLM API Key ───────────────────────────────────────────────────────────────
# Works with DeepSeek (recommended) or OpenAI
OPENAI_API_KEY=your-llm-api-key-here

# ── LLM Settings ──────────────────────────────────────────────────────────────
# DeepSeek (cost-effective, recommended):
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
# OpenAI GPT-4o (comment out above, uncomment below):
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=16384

# ── Database ──────────────────────────────────────────────────────────────────
# Dev mode: SQLite (no setup required)
USE_SQLITE=true

# Production: PostgreSQL (set USE_SQLITE=false and fill in below)
# USE_SQLITE=false
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=aicfo
# POSTGRES_USER=aicfo
# POSTGRES_PASSWORD=changeme

# Or override entirely with a full URL:
# DATABASE_URL_OVERRIDE=postgresql+asyncpg://user:pass@host:5432/dbname

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_SECRET_KEY=change-this-to-a-random-secret-32-chars
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── NextAuth (required for auth to work) ──────────────────────────────────────
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=change-this-to-a-random-32-char-secret
NEXTAUTH_URL=http://localhost:3000

# ── Pilot Program ─────────────────────────────────────────────────────────────
PILOT_MODE=true
PILOT_MAX_USERS=5
# Set to false to disable invite-code requirement (open registration)
PILOT_REQUIRE_INVITE=true

# ── File Storage ──────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_SIZE_MB=10
# FULL AUTOMATION
# Upload tamamlanınca CFO analizi otomatik kuyruğa alınsın mı?
AUTO_ENQUEUE_ANALYSIS_ON_UPLOAD=true
# RAG bakım görevi (eksik chunk index backfill)
RAG_BACKFILL_ENABLED=true
RAG_BACKFILL_LOOKBACK_DAYS=14
RAG_EMBEDDING_ENABLED=true
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536

# LangGraph checkpointer (resume interrupted CFO runs by job_id thread)
# memory | sqlite | postgres — default follows USE_SQLITE
# LANGGRAPH_CHECKPOINT=sqlite
# LANGGRAPH_CHECKPOINT_SQLITE=./langgraph_checkpoints.sqlite

# International org defaults (overridable per-org via PATCH /org/me)
# DEFAULT_COUNTRY_CODE=US
# DEFAULT_BASE_CURRENCY=USD
# DEFAULT_LOCALE=en-US
FRONTEND_URL=http://localhost:3000

# S3 (optional, set STORAGE_BACKEND=s3 to use):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=us-east-1

# ── Redis (optional — not required for SQLite dev mode) ───────────────────────
REDIS_URL=redis://localhost:6379/0
# ARQ queue partitioning (high traffic backpressure control)
ARQ_ANALYSIS_QUEUE_NAME=arq:queue:analysis
ARQ_MAINTENANCE_QUEUE_NAME=arq:queue:maintenance
ARQ_ANALYSIS_MAX_JOBS=10
ARQ_MAINTENANCE_MAX_JOBS=3

# ── Email Ingest (Passive Intelligence) ──────────────────────────────────────
# Forward muhasebe emaillerini bu adrese yönlendirin.
# Webhook provider: SendGrid Inbound Parse, Mailgun, AWS SES, Postmark
#
# Kullanım:
#   1. EMAIL_INGEST_DOMAIN ayarlayın (ör: ingest.yourapp.com)
#   2. DNS: MX kaydı provider'a yönlendirir
#   3. Provider webhook → POST /api/v1/email/ingest
#   4. Kullanıcıya org-specific adres: {org_id}@{EMAIL_INGEST_DOMAIN}
#
# Güvenlik:
#   - EMAIL_INGEST_API_KEY: webhook provider secret'ı doğrulamak için
#   - EMAIL_ALLOWED_DOMAINS: virgülle ayrılmış izin verilen gönderen domain'ler (boş = herkese açık)
EMAIL_INGEST_DOMAIN=ingest.yourapp.com
EMAIL_INGEST_API_KEY=
EMAIL_ALLOWED_DOMAINS=
# Max attachment size in MB (default: 10)
EMAIL_MAX_ATTACHMENT_MB=10

# ── SMTP Notifications (outgoing alerts via email) ────────────────────────────
# SendGrid, Mailgun, Amazon SES veya herhangi bir SMTP sunucusu
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM=noreply@yourapp.com
# Global Slack webhook (per-org overrides via Dashboard > Settings > Notifications)
SLACK_WEBHOOK_URL=

# ── ERP Integrations ──────────────────────────────────────────────────────────
# Paraşüt OAuth2 (https://developer.parasut.com)
PARASUT_CLIENT_ID=
PARASUT_CLIENT_SECRET=
PARASUT_REDIRECT_URI=http://localhost:8000/api/v1/erp/parasut/callback
# Logo Tiger / Mikro: CSV/Excel export upload — no OAuth needed

# ── Open Banking (Turkish Banks) ─────────────────────────────────────────────
# Sandbox mode (no real bank data):
OPEN_BANKING_SANDBOX=true
# Set to false in production:
# OPEN_BANKING_SANDBOX=false
# OPENBANKING_GARANTI_CLIENT_ID=
# OPENBANKING_GARANTI_CLIENT_SECRET=
# OPENBANKING_AKBANK_CLIENT_ID=
# OPENBANKING_AKBANK_CLIENT_SECRET=

# ── GİB e-Fatura (optional) ───────────────────────────────────────────────────
# Test ortamı varsayılan; üretimde GIB_SANDBOX=false yapın
GIB_SANDBOX=true
# GIB_VKN=          # Vergi Kimlik Numarası (10 hane)
# GIB_USERNAME=     # e-Fatura portal kullanıcı adı
# GIB_PASSWORD=     # e-Fatura portal şifresi

# ── Stripe Billing (optional) ────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
