# ──────────────────────────────────────────────
# AI CFO — Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ── OpenAI ────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...

# LLM model — gpt-4o recommended, gpt-4o-mini works for dev
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=16384

# ── PostgreSQL ────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aicfo
POSTGRES_USER=aicfo
POSTGRES_PASSWORD=changeme

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Backend App ───────────────────────────────
BACKEND_SECRET_KEY=dev-secret-change-in-production-min-32-chars
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_PORT=8000

# ── Storage ───────────────────────────────────
# local = store files on disk under storage_local_path
# s3    = store in AWS S3 (requires S3_BUCKET, AWS_* vars)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads

# Uncomment for S3 storage:
# S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1

# ── File Upload ───────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ── Frontend (Next.js) ────────────────────────
# This is baked into the frontend build — must match BACKEND_PORT above
NEXT_PUBLIC_API_URL=http://localhost:8000
