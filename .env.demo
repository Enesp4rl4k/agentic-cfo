# AI CFO Suite — Demo Environment Variables
# ==========================================
# Copy this file as-is for demo. No changes needed unless you have a real LLM key.
#
# ⚠ NEVER commit real API keys. This file contains only demo placeholders.

# ── LLM (Required for AI narratives & chat) ──────────────────────────────────
# Get a free DeepSeek key: https://platform.deepseek.com  (~$0.001/analysis)
# Or use OpenAI: https://platform.openai.com
#
# If left as placeholder, the app still works — pure financial calculations run,
# but LLM-generated narratives and chat will return a friendly "no key" message.
OPENAI_API_KEY=sk-demo-placeholder-replace-with-real-key

# DeepSeek (recommended — 10x cheaper than GPT-4):
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=16384

# OpenAI GPT-4o (uncomment to use instead):
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=
# OPENAI_API_KEY=sk-your-real-key-here

# ── Database (set by docker-compose.demo.yml) ─────────────────────────────────
USE_SQLITE=false
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aicfo_demo
POSTGRES_USER=aicfo
POSTGRES_PASSWORD=demo_pass_2024

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_SECRET_KEY=demo-secret-key-change-in-production-minimum-32-chars
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true

# ── File Storage ──────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_SIZE_MB=10

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# When true, the app shows a demo banner and pre-loads sample data
DEMO_MODE=true
DEMO_COMPANY_NAME=TechNova Yazılım A.Ş.

# ── Optional Integrations (leave empty to skip) ───────────────────────────────
# Turkish e-Invoice (GİB):
GIB_VKN=
GIB_USERNAME=
GIB_PASSWORD=
GIB_SANDBOX=true

# Turkish Open Banking (Akbank, Garanti — sandbox by default):
AKBANK_CLIENT_ID=
AKBANK_CLIENT_SECRET=
GARANTI_CLIENT_ID=
GARANTI_CLIENT_SECRET=
OPEN_BANKING_SANDBOX=true

# TCMB Benchmark Data (free key — get at https://evds2.tcmb.gov.tr):
TCMB_API_KEY=
