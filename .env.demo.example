# AI CFO Suite — Demo Environment Template
# Copy to .env.demo locally (never commit .env.demo with real credentials)
#
#   cp .env.demo.example .env.demo

# ── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=llm-placeholder-demo
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=16384

# ── Database (docker-compose demo) ───────────────────────────────────────────
USE_SQLITE=false
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aicfo_demo
POSTGRES_USER=aicfo
POSTGRES_PASSWORD=change-me-demo-only

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_SECRET_KEY=change-me-demo-secret-minimum-32-chars
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true

# ── Demo mode ─────────────────────────────────────────────────────────────────
DEMO_MODE=true
DEMO_COMPANY_NAME=Demo Company
