# Line endings: every text file is stored with LF (it already is: `git ls-files --eol`
# shows i/lf for all 1,242 text files). Checking out LF too stops the CRLF/LF noise
# that made untouched files look modified on Windows (core.autocrlf=true).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touch binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.xls binary
*.zip binary
*.db binary
*.sqlite binary
*.woff binary
*.woff2 binary
